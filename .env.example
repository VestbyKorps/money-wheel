# --- Required in production (Coolify) ---
SECRET_KEY=generate-a-long-random-string
POSTGRES_PASSWORD=generate-a-strong-db-password

# --- Database (defaults work for local compose) ---
POSTGRES_USER=aarshjul
POSTGRES_DB=aarshjul

# --- Admin seed (created only when DB is empty) ---
SEED_ADMIN_EMAIL=admin@korps.example
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_NAME=Administrator

# --- CORS: * is fine when web proxies /api same-origin.
# For a separate mobile/API host, list public origins comma-separated.
CORS_ORIGINS=*

# --- Ports (local docker compose). Coolify maps domains instead.
WEB_PORT=3847
API_PORT=3848

# --- Frontend API base. Leave empty for same-origin (/api via nginx).
# Local Vite only: VITE_API_URL=http://127.0.0.1:3848
VITE_API_URL=
